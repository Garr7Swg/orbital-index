# ---------------------------------------------------------------------------
# Orbital Index — environment variables
# Copy to .env.local and fill in what you have. Every integration is optional:
# the app falls back to live-API caching when no database is configured.
# ---------------------------------------------------------------------------

# Launch Library 2 (optional key raises the rate limit from ~15 to ~30 req/hour)
LL2_API_KEY=
LL2_BASE_URL=https://ll.thespacedevs.com/2.3.0

# Postgres (Supabase or Neon). Use the pooled connection string.
# Without it, data is cached in process memory only.
DATABASE_URL=

# Upstash Redis (optional short-term response cache)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# AI assistant — Groq chat + Gemini embeddings (both optional, degrade gracefully)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.0-flash
GEMINI_EMBED_MODEL=text-embedding-004

# Supabase auth (optional — enables sign up / sign out and saved launches)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# URL configuration — localhost and cloud
# ---------------------------------------------------------------------------
# Leave blank for automatic detection. The app resolves the origin per request:
#   localhost  → http://127.0.0.1:3000   (npm run dev)
#   Vercel     → https://<deployment>.vercel.app  (preview or production)
#   custom     → https://your-domain.com
# Set it only when a proxy/load balancer rewrites the request origin, e.g.
#   NEXT_PUBLIC_SITE_URL=https://orbital-index.vercel.app
# Vercel injects VERCEL_URL and VERCEL_PROJECT_PRODUCTION_URL automatically.
NEXT_PUBLIC_SITE_URL=

# Shared secret for the /api/cron/sync endpoint.
# Set the same value in Vercel → Settings → Environment Variables; Vercel sends
# it as "Authorization: Bearer $CRON_SECRET" when the cron fires.
CRON_SECRET=
